# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_insight
DB_USER=task_insight_app
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Refresh tokens are stored only in an HttpOnly cookie named dms_refresh_token.

# Server Configuration
PORT=5000
NODE_ENV=development

# File Upload Configuration
# MAX_FILE_SIZE in bytes. Default is 100MB; raise deliberately only for trusted deployments.
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif,mp4,avi,mov,xlsx,xls,ppt,pptx,zip,rar
ALLOWED_MIME_TYPES=
MALWARE_SCAN_ENABLED=false
# Example: clamscan
MALWARE_SCAN_COMMAND=
# Optional args. Use {filePath} placeholder, otherwise the file path is appended.
MALWARE_SCAN_ARGS=
MALWARE_SCAN_TIMEOUT_MS=30000

# PDF OCR/Text Extraction
# Default extracts embedded text with Poppler's pdftotext, then falls back to Poppler + Tesseract OCR for scanned PDFs.
OCR_TEXT_COMMAND=pdftotext
OCR_TEXT_ARGS=-layout {input} {output}
OCR_TIMEOUT_MS=120000
OCR_IMAGE_FALLBACK_ENABLED=true
OCR_PDF_IMAGE_COMMAND=pdftoppm
OCR_PDF_IMAGE_ARGS=-r 300 -png {input} {prefix}
OCR_IMAGE_TEXT_COMMAND=tesseract
OCR_IMAGE_TEXT_ARGS={image} stdout -l eng
OCR_IMAGE_LANG=eng

# Server Timeout Configuration (in milliseconds)
# For large file uploads, set a longer timeout
# Default: 7200000 (2 hours)
# For very large files (10GB+), consider: 14400000 (4 hours)
SERVER_TIMEOUT=7200000

# Email Configuration (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@taskinsight.com

# Rate Limiting
DISABLE_RATE_LIMITS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=

# Storage
STORAGE_TYPE=local
MAX_STORAGE_PER_ORG=5368709120

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
